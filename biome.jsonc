{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  // Ultracite 7 ships one preset per framework; stack them.
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": [
      // The release shim predates this config and is not part of the
      // monorepo's TypeScript surface.
      "!packaging",
      "!**/node_modules",
      "!**/.turbo",
      "!**/.output",
      "!**/.wxt",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!target",
      "!result"
    ]
  },
  "overrides": [
    {
      // A package's public entry point is a barrel on purpose. The rule is
      // aimed at accidental ones inside a package.
      "includes": ["packages/*/src/index.ts"],
      "linter": { "rules": { "performance": { "noBarrelFile": "off" } } }
    },
    {
      // shadcn primitives are vendored by `shadcn add` and replaced wholesale
      // when it is re-run, so local edits do not survive. They are formatted
      // like the rest of the repo but not argued with.
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off" },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noLeakedRender": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    }
  ]
}
