{
  "comment": "The source of truth for the native messaging contract. Both packages/protocol (Zod) and crates/nopass-host (serde) are tested against this file, so neither can drift. Valid cases must round-trip: parse then re-serialise must deep-equal the original.",
  "protocolVersion": 2,
  "requests": [
    {
      "name": "hello announces the extension's protocol version",
      "valid": true,
      "json": {
        "id": 1,
        "verb": "hello",
        "version": 2
      }
    },
    {
      "name": "status asks whether the store is unlocked",
      "valid": true,
      "json": {
        "id": 2,
        "verb": "status"
      }
    },
    {
      "name": "unlock carries the passphrase",
      "valid": true,
      "json": {
        "id": 3,
        "verb": "unlock",
        "passphrase": "correct horse battery staple"
      }
    },
    {
      "name": "lock drops the cached identity",
      "valid": true,
      "json": {
        "id": 4,
        "verb": "lock"
      }
    },
    {
      "name": "list asks for entry names",
      "valid": true,
      "json": {
        "id": 5,
        "verb": "list"
      }
    },
    {
      "name": "search matches entries against a page origin",
      "valid": true,
      "json": {
        "id": 6,
        "verb": "search",
        "origin": "https://mail.google.com"
      }
    },
    {
      "name": "get asks for one entry's secret",
      "valid": true,
      "json": {
        "id": 7,
        "verb": "get",
        "entry": "web/google.com"
      }
    },
    {
      "name": "generate asks for a password it will not store",
      "valid": true,
      "json": {
        "id": 8,
        "verb": "generate",
        "length": 24,
        "symbols": true
      }
    },
    {
      "name": "an unknown verb is rejected",
      "valid": false,
      "json": {
        "id": 9,
        "verb": "telepathy"
      }
    },
    {
      "name": "insert creates a login: a secret and its canonical fields",
      "valid": true,
      "json": {
        "id": 10,
        "verb": "insert",
        "entry": "web/example.com",
        "kind": "login",
        "secret": "hunter2",
        "fields": [
          {
            "key": "username",
            "value": "sana@example.com"
          },
          {
            "key": "url",
            "value": "https://example.com/login"
          }
        ]
      }
    },
    {
      "name": "insert may carry nothing but a secret, and no kind means login",
      "valid": true,
      "json": {
        "id": 10,
        "verb": "insert",
        "entry": "web/example.com",
        "secret": "hunter2"
      }
    },
    {
      "name": "insert with an empty secret is rejected for a kind that has one",
      "valid": false,
      "json": {
        "id": 10,
        "verb": "insert",
        "entry": "web/example.com",
        "secret": ""
      }
    },
    {
      "name": "a newline in a field value is rejected: it would forge a second field",
      "valid": false,
      "json": {
        "id": 10,
        "verb": "insert",
        "entry": "web/example.com",
        "secret": "hunter2",
        "fields": [
          {
            "key": "url",
            "value": "https://a.b\nurl: https://phish.example"
          }
        ]
      }
    },
    {
      "name": "edit is rejected: the host may create but never rewrite (ADR-0006)",
      "valid": false,
      "json": {
        "id": 11,
        "verb": "edit",
        "entry": "web/example.com"
      }
    },
    {
      "name": "rm is rejected: the host may create but never destroy (ADR-0006)",
      "valid": false,
      "json": {
        "id": 12,
        "verb": "rm",
        "entry": "web/example.com"
      }
    },
    {
      "name": "mv is rejected: the host may create but never move (ADR-0006)",
      "valid": false,
      "json": {
        "id": 13,
        "verb": "mv",
        "from": "a",
        "to": "b"
      }
    },
    {
      "name": "cp is rejected: the host may create but never copy (ADR-0006)",
      "valid": false,
      "json": {
        "id": 14,
        "verb": "cp",
        "from": "a",
        "to": "b"
      }
    },
    {
      "name": "a request without an id is rejected",
      "valid": false,
      "json": {
        "verb": "status"
      }
    },
    {
      "name": "a negative id is rejected",
      "valid": false,
      "json": {
        "id": -1,
        "verb": "status"
      }
    },
    {
      "name": "unlock without a passphrase is rejected",
      "valid": false,
      "json": {
        "id": 15,
        "verb": "unlock"
      }
    },
    {
      "name": "search without an origin is rejected",
      "valid": false,
      "json": {
        "id": 16,
        "verb": "search"
      }
    },
    {
      "name": "get with an empty entry name is rejected",
      "valid": false,
      "json": {
        "id": 17,
        "verb": "get",
        "entry": ""
      }
    },
    {
      "name": "generate below the minimum length is rejected",
      "valid": false,
      "json": {
        "id": 18,
        "verb": "generate",
        "length": 3,
        "symbols": false
      }
    },
    {
      "name": "generate above the maximum length is rejected",
      "valid": false,
      "json": {
        "id": 19,
        "verb": "generate",
        "length": 1025,
        "symbols": false
      }
    },
    {
      "name": "insert creates a card, whose secret is its number",
      "valid": true,
      "json": {
        "id": 11,
        "verb": "insert",
        "entry": "cards/visa",
        "kind": "card",
        "secret": "4111111111111111",
        "fields": [
          {
            "key": "cardholder",
            "value": "Sana Qureshi"
          },
          {
            "key": "exp-month",
            "value": "04"
          },
          {
            "key": "exp-year",
            "value": "2029"
          },
          {
            "key": "brand",
            "value": "Visa"
          }
        ]
      }
    },
    {
      "name": "insert creates an identity, which has no secret at all",
      "valid": true,
      "json": {
        "id": 12,
        "verb": "insert",
        "entry": "me/home",
        "kind": "identity",
        "fields": [
          {
            "key": "given-name",
            "value": "Sana"
          },
          {
            "key": "family-name",
            "value": "Qureshi"
          },
          {
            "key": "country",
            "value": "Bangladesh"
          }
        ]
      }
    },
    {
      "name": "a field key that is not a bare token is rejected",
      "valid": false,
      "json": {
        "id": 13,
        "verb": "insert",
        "entry": "web/example.com",
        "secret": "hunter2",
        "fields": [
          {
            "key": "Given Name",
            "value": "Sana"
          }
        ]
      }
    },
    {
      "name": "a field may not smuggle the type line, which the kind owns",
      "valid": false,
      "json": {
        "id": 14,
        "verb": "insert",
        "entry": "web/example.com",
        "secret": "hunter2",
        "fields": [
          {
            "key": "type",
            "value": "card"
          }
        ]
      }
    },
    {
      "name": "an unknown kind is rejected rather than written as a type line",
      "valid": false,
      "json": {
        "id": 15,
        "verb": "insert",
        "entry": "web/example.com",
        "kind": "telepathy",
        "secret": "hunter2"
      }
    },
    {
      "name": "update rewrites the fields it names and leaves the rest alone (ADR-0009)",
      "valid": true,
      "json": {
        "id": 16,
        "verb": "update",
        "entry": "web/example.com",
        "fields": [
          {
            "key": "username",
            "value": "someone@else"
          }
        ]
      }
    },
    {
      "name": "update may replace the secret on its own",
      "valid": true,
      "json": {
        "id": 17,
        "verb": "update",
        "entry": "web/example.com",
        "secret": "new-password"
      }
    },
    {
      "name": "update may clear a field by writing it empty",
      "valid": true,
      "json": {
        "id": 18,
        "verb": "update",
        "entry": "web/example.com",
        "fields": [
          {
            "key": "totp",
            "value": ""
          }
        ]
      }
    },
    {
      "name": "update that changes nothing is rejected",
      "valid": false,
      "json": {
        "id": 19,
        "verb": "update",
        "entry": "web/example.com"
      }
    },
    {
      "name": "items asks for the entries of a kind, names and hints only",
      "valid": true,
      "json": {
        "id": 20,
        "verb": "items",
        "kinds": [
          "card",
          "identity"
        ]
      }
    },
    {
      "name": "items with no kinds asks for everything",
      "valid": true,
      "json": {
        "id": 21,
        "verb": "items"
      }
    },
    {
      "name": "items for a kind this protocol does not define is rejected",
      "valid": false,
      "json": {
        "id": 22,
        "verb": "items",
        "kinds": [
          "ssh-key"
        ]
      }
    }
  ],
  "responses": [
    {
      "name": "hello replies with the version and store state",
      "valid": true,
      "json": {
        "id": 1,
        "ok": true,
        "verb": "hello",
        "version": 2,
        "store": "ready"
      }
    },
    {
      "name": "hello reports a store that was never initialised",
      "valid": true,
      "json": {
        "id": 1,
        "ok": true,
        "verb": "hello",
        "version": 2,
        "store": "missing"
      }
    },
    {
      "name": "status reports a locked store",
      "valid": true,
      "json": {
        "id": 2,
        "ok": true,
        "verb": "status",
        "state": "locked",
        "expiresIn": 0
      }
    },
    {
      "name": "status reports an unlocked store with time left",
      "valid": true,
      "json": {
        "id": 2,
        "ok": true,
        "verb": "status",
        "state": "unlocked",
        "expiresIn": 275
      }
    },
    {
      "name": "unlock succeeds",
      "valid": true,
      "json": {
        "id": 3,
        "ok": true,
        "verb": "unlock",
        "state": "unlocked",
        "expiresIn": 300
      }
    },
    {
      "name": "lock succeeds",
      "valid": true,
      "json": {
        "id": 4,
        "ok": true,
        "verb": "lock",
        "state": "locked"
      }
    },
    {
      "name": "list returns names only, never secrets",
      "valid": true,
      "json": {
        "id": 5,
        "ok": true,
        "verb": "list",
        "entries": [
          "web/github.com",
          "web/google.com",
          "mail/fastmail"
        ]
      }
    },
    {
      "name": "search returns matches with the fields needed to render a row",
      "valid": true,
      "json": {
        "id": 6,
        "ok": true,
        "verb": "search",
        "matches": [
          {
            "name": "web/google.com",
            "kind": "login",
            "username": "sana@example.com",
            "url": "https://google.com"
          },
          {
            "name": "web/google.com-work",
            "kind": "login"
          }
        ]
      }
    },
    {
      "name": "get returns one entry: its kind, its secret and its fields",
      "valid": true,
      "json": {
        "id": 7,
        "ok": true,
        "verb": "get",
        "entry": {
          "name": "web/google.com",
          "kind": "login",
          "secret": "hunter2",
          "fields": [
            {
              "key": "username",
              "value": "sana@example.com"
            },
            {
              "key": "url",
              "value": "https://google.com"
            },
            {
              "key": "totp",
              "value": "otpauth://totp/google?secret=JBSWY3DPEHPK3PXP"
            }
          ]
        }
      }
    },
    {
      "name": "get returns an entry that carries nothing but a secret",
      "valid": true,
      "json": {
        "id": 7,
        "ok": true,
        "verb": "get",
        "entry": {
          "name": "web/minimal.example",
          "kind": "login",
          "secret": "hunter2",
          "fields": []
        }
      }
    },
    {
      "name": "generate returns a password",
      "valid": true,
      "json": {
        "id": 8,
        "ok": true,
        "verb": "generate",
        "password": "aX7!qm2Ldp0Ze4Rv"
      }
    },
    {
      "name": "insert confirms the entry it created, and nothing else",
      "valid": true,
      "json": {
        "id": 10,
        "ok": true,
        "verb": "insert",
        "entry": "web/example.com"
      }
    },
    {
      "name": "a name already in the store is its own refusal, not an overwrite",
      "valid": true,
      "json": {
        "id": 10,
        "ok": false,
        "error": {
          "code": "exists",
          "message": "web/example.com is already in the store"
        }
      }
    },
    {
      "name": "an error names a machine-readable code",
      "valid": true,
      "json": {
        "id": 7,
        "ok": false,
        "error": {
          "code": "locked",
          "message": "the store is locked"
        }
      }
    },
    {
      "name": "a read-only refusal is its own code",
